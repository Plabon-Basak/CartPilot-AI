# Example environment variables for CartPilot AI
# Fill in actual values in .env (which is gitignored)

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Comma-separated browser origins allowed by the backend.
# Add the production Vercel origin, for example:
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GEMINI_API_KEY=
