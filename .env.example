# CartPilot AI environment template
#
# Copy this file to backend/.env and replace the placeholder values with
# Sandbox/test credentials. The backend loads backend/.env when Uvicorn is
# started from the backend directory.
#
# Never commit backend/.env or any real credentials.

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

FRONTEND_RETURN_URL=http://localhost:5173/?paypal=return
FRONTEND_CANCEL_URL=http://localhost:5173/?paypal=cancel

# Comma-separated browser origins allowed by the backend.
# Add the deployed Vercel origin, for example:
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GEMINI_API_KEY=your_gemini_api_key
# Optional. Verify the model name is available to your Gemini API key.
# The application config currently defaults to gemini-3.5-flash.
GEMINI_MODEL=your_available_gemini_model

# Frontend configuration is separate. The tracked frontend/.env.development
# already contains:
# VITE_API_BASE_URL=http://localhost:8000
#
# Do not put secrets in VITE_* variables; they are bundled into client-side code.
